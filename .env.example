# Copie ce fichier en .env et remplis les valeurs. .env est ignoré par git.

# Connexion DB (Supabase → Project Settings → Database → Connection string)
SUPABASE_DB_URL=

# Clé Gemini (gratuite, EEA no-train — https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Clé Groq (facultatif — fallback illimité ~14 400 req/j, mais tier
# gratuit non-no-train → sera automatiquement refusé pour les vraies
# données client par le gateway. Génération : https://console.groq.com/keys)
GROQ_API_KEY=

# Les leads de démo sont désormais stockés directement dans Supabase
# (table `lead`, tenant de démo créé par la migration 0003). Aucune
# variable supplémentaire nécessaire — voir docs/DECISIONS.md ADR-009.
