{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    // Les paquets exposent leurs sources (`"types": "./src/index.ts"`) : rien n'est compilé, la
    // résolution se fait par le lien de l'espace de travail. `composite` et les `references`
    // exigeraient une compilation préalable pour un bénéfice nul ici.
    "noEmit": true
  }
}
