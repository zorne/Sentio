# Copier en .env.local (ignoré par git) et remplir.
# NEXT_PUBLIC_* sont exposées au navigateur (nécessaire pour Supabase Auth + Realtime).

NEXT_PUBLIC_SUPABASE_URL=https://rybeumdjclajiypglmuj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Connexion directe DB pour les Server Actions (même valeur que le
# SUPABASE_DB_URL du .env racine) — reste côté serveur, jamais exposée.
SUPABASE_DB_URL=

# Clés IA (mêmes valeurs que le .env racine)
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Secrets qui n'ont pas de valeur de repli, et c'est voulu ────────────────────
# Les deux premiers protégeaient quelque chose en échouant OUVERT quand ils
# manquaient. Ils échouent fermé désormais : sans eux, la fonctionnalité refuse
# de démarrer plutôt que de laisser passer.

# Le sel de hachage des adresses des visiteurs du diagnostic. Sans lui, les
# adresses seraient stockées sous une forme réversible. N'importe quelle chaîne
# longue et aléatoire fait l'affaire, différente en développement et en ligne.
SENTIO_IP_HASH_SALT=

# Le jeton du cycle de prospection planifié. La route déclenche de vrais envois :
# elle refuse de s'exécuter si ce jeton n'est pas posé.
CRON_SECRET=

# ── Le reste, lu par le code et jusqu'ici documenté nulle part ──────────────────

# Envoi des notifications par email. Voir docs/31 §8 : compte séparé du compte
# personnel, domaine configuré en région UE, clé jamais dans le dépôt.
RESEND_API_KEY=

# Paiement. Sans STRIPE_SECRET_KEY, le paiement en ligne reste désactivé.
STRIPE_SECRET_KEY=
STRIPE_LINK_STANDARD=
STRIPE_LINK_PROFESSIONNEL=
STRIPE_LINK_ENTREPRISE=

# L'adresse publique du site, utilisée pour construire les liens des emails.
NEXT_PUBLIC_APP_URL=
